# ============================================================
# SmartCockpit Git LFS 追踪规则
# ============================================================

# Linux 启动脚本固定使用 LF，避免 Windows 检出后无法在板端执行。
*.sh text eol=lf

# ── LLM / RKNN 模型文件 ─────────────────────────────────────
*.rkllm filter=lfs diff=lfs merge=lfs -text
*.rknn filter=lfs diff=lfs merge=lfs -text

# ── ONNX / JIT 推理模型 ─────────────────────────────────────
*.onnx filter=lfs diff=lfs merge=lfs -text
*.jit filter=lfs diff=lfs merge=lfs -text

# ── 共享库 ───────────────────────────────────────────────────
*.so filter=lfs diff=lfs merge=lfs -text

# ── Live2D / 3D 模型资源 ────────────────────────────────────
*.cmo3 filter=lfs diff=lfs merge=lfs -text

# ── 音频资源 ─────────────────────────────────────────────────
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text

# ── 大型图片资源 ─────────────────────────────────────────────
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text

# ── SenseVoice / 其他大型二进制模型 ──────────────────────────
*.bin filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text

# ── RK3588 离线迁移归档 ─────────────────────────────────────
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.tar.bz2 filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
Miniconda3-*.sh filter=lfs diff=lfs merge=lfs -text
*.cache filter=lfs diff=lfs merge=lfs -text
