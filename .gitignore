# ============================================================
# SmartCockpit .gitignore
# ============================================================

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/
*.whl

# ── 虚拟环境 / Conda 打包环境 ────────────────────────────────
*.tar.gz
Miniconda3-*.sh

# ── 超大模型文件（超过 GitHub LFS 2GB 限制，通过网盘/NAS 分发）──
models/*.rkllm
models/*.rknn
models/**/*.rkllm
models/**/*.rknn

# ── RK3588 仅保存最新分卷，完整归档为本地构建中间材料 ─────────
/output/rk3588-deploy/*.new

# ── 本地检查材料与部署包分卷副本 ────────────────────────────
/tmp/
/output/.inspect-verify.sh
/output/.rk3588-source-compare-*/
/output/rk3588-deploy.zip
/output/rk3588-deploy.z[0-9][0-9]

# ── 临时文件 ─────────────────────────────────────────────────
voice-assistant-server/tmp/
*.log
*.pid
*.cache

# ── 运行时覆盖配置（用户本地配置，不入库）─────────────────────
voice-assistant-server/data/.config.yaml

# ── SSL 证书（敏感文件）─────────────────────────────────────
.ssl/

# ── OS / IDE ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
