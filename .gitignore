# ============================================================
# SmartCockpit .gitignore
# ============================================================

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/
*.whl

# ── 虚拟环境 / Conda 打包环境 ────────────────────────────────
*.tar.gz
Miniconda3-*.sh

# ── 超大模型文件（超过 GitHub LFS 2GB 限制，通过网盘/NAS 分发）──
models/*.rkllm

# ── 临时文件 ─────────────────────────────────────────────────
voice-assistant-server/tmp/
*.log
*.pid
*.cache

# ── 运行时覆盖配置（用户本地配置，不入库）─────────────────────
voice-assistant-server/data/.config.yaml

# ── SSL 证书（敏感文件）─────────────────────────────────────
.ssl/

# ── OS / IDE ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
