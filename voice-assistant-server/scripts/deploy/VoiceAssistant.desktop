[Desktop Entry]
Version=1.0
Type=Application
Name=Voice Assistant
Name[zh_CN]=语音助手服务
Comment=Open SmartCockpit Web UI or show the current startup status
Comment[zh_CN]=打开 Web 客户端或提示当前服务启动状态
Exec=/opt/jw/voice-assistant-server/scripts/deploy/startup-notifier.sh --manual
